\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Coeficientes $\beta $ estandarizados del modelo logístico (sklearn, L2) en Fase 2, comparados con los de Fase 1. Los pesos normalizados derivados sitúan PD en el 53.2\%, CONS en el 25.9\%, nGAIN en el 9.8\%, AMB en el 8.1\% y LEC en el 3.7\%.}}{23}{table.caption.23}\protected@file@percent }
\newlabel{tab:coef_logistica_f2}{{11}{23}{Coeficientes $\beta $ estandarizados del modelo logístico (sklearn, L2) en Fase 2, comparados con los de Fase 1. Los pesos normalizados derivados sitúan PD en el 53.2\%, CONS en el 25.9\%, nGAIN en el 9.8\%, AMB en el 8.1\% y LEC en el 3.7\%}{table.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Importancia relativa de las métricas de calidad en el modelo logístico de Fase 2 (pesos normalizados a partir de $|\beta |$). PD absorbe más del 53\% del peso total, mientras que en Fase 1 su contribución era de aproximadamente el 34\%. CONS emerge como segundo factor relevante (25.9\%) desde una posición prácticamente irrelevante en mundo abierto (2\%).}}{23}{figure.caption.24}\protected@file@percent }
\newlabel{fig:logistic_importance_f2}{{13}{23}{Importancia relativa de las métricas de calidad en el modelo logístico de Fase 2 (pesos normalizados a partir de $|\beta |$). PD absorbe más del 53\% del peso total, mientras que en Fase 1 su contribución era de aproximadamente el 34\%. CONS emerge como segundo factor relevante (25.9\%) desde una posición prácticamente irrelevante en mundo abierto (2\%)}{figure.caption.24}{}}
