\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {0.1.5.3}Comparación de las tres variantes de $Q$}{24}{subsubsection.0.1.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Panel resumen ($2\times 3$) con las seis comparaciones entre las tres variantes de $Q$. Fila superior: histogramas superpuestos, box plots y violin plots. Fila inferior: diagramas de dispersión para cada par de variantes ($Q$~Inicial vs $Q$~M.Abierto, $Q$~Inicial vs $Q$~M.Cerrado, $Q$~M.Abierto vs $Q$~M.Cerrado). Azul: $Q$ Inicial; morado: $Q$ Mundo Abierto; verde: $Q$ Mundo Cerrado.}}{24}{figure.caption.25}\protected@file@percent }
\newlabel{fig:q_comparison_f2}{{14}{24}{Panel resumen ($2\times 3$) con las seis comparaciones entre las tres variantes de $Q$. Fila superior: histogramas superpuestos, box plots y violin plots. Fila inferior: diagramas de dispersión para cada par de variantes ($Q$~Inicial vs $Q$~M.Abierto, $Q$~Inicial vs $Q$~M.Cerrado, $Q$~M.Abierto vs $Q$~M.Cerrado). Azul: $Q$ Inicial; morado: $Q$ Mundo Abierto; verde: $Q$ Mundo Cerrado}{figure.caption.25}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Histogramas superpuestos de las tres variantes de $Q$ sobre las 360 pistas. La $Q$ Inicial (azul) concentra masa en una banda estrecha centrada en valores medios, reflejo de que todos los pesos eran moderados. La $Q$ Mundo Abierto (morado) se desplaza según la doble dominancia de PD y LEC. La $Q$ Mundo Cerrado (verde) muestra la mayor dispersión, consecuencia del dominio extremo de PD (53\%): las pistas con PD alto se separan claramente del resto.}}{25}{figure.caption.26}\protected@file@percent }
\newlabel{fig:q_hist_f2}{{15}{25}{Histogramas superpuestos de las tres variantes de $Q$ sobre las 360 pistas. La $Q$ Inicial (azul) concentra masa en una banda estrecha centrada en valores medios, reflejo de que todos los pesos eran moderados. La $Q$ Mundo Abierto (morado) se desplaza según la doble dominancia de PD y LEC. La $Q$ Mundo Cerrado (verde) muestra la mayor dispersión, consecuencia del dominio extremo de PD (53\%): las pistas con PD alto se separan claramente del resto}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Diagramas de caja comparativos de las tres variantes de $Q$. La comparación de medianas y rangos intercuartílicos revela cómo el rebalanceo de pesos entre variantes desplaza la tendencia central y modifica la asimetría de la distribución. La mayor varianza de $Q$ Mundo Cerrado es consistente con la polarización inducida por el peso dominante de PD.}}{25}{figure.caption.27}\protected@file@percent }
\newlabel{fig:q_boxplot_f2}{{16}{25}{Diagramas de caja comparativos de las tres variantes de $Q$. La comparación de medianas y rangos intercuartílicos revela cómo el rebalanceo de pesos entre variantes desplaza la tendencia central y modifica la asimetría de la distribución. La mayor varianza de $Q$ Mundo Cerrado es consistente con la polarización inducida por el peso dominante de PD}{figure.caption.27}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Diagramas de violín de las tres variantes de $Q$. La forma del violín revela la densidad de probabilidad en cada punto del rango de valores. La $Q$ Inicial muestra una forma más compacta y simétrica; la $Q$ Mundo Cerrado presenta una forma más elongada con un pico pronunciado en valores medios-bajos y cola más larga en los valores altos, asociada a las pistas con PD excepcional.}}{26}{figure.caption.28}\protected@file@percent }
\newlabel{fig:q_violin_f2}{{17}{26}{Diagramas de violín de las tres variantes de $Q$. La forma del violín revela la densidad de probabilidad en cada punto del rango de valores. La $Q$ Inicial muestra una forma más compacta y simétrica; la $Q$ Mundo Cerrado presenta una forma más elongada con un pico pronunciado en valores medios-bajos y cola más larga en los valores altos, asociada a las pistas con PD excepcional}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Diagramas de dispersión para cada par de variantes. \textit  {Izquierda}: $Q$ Inicial vs $Q$ Mundo Abierto — la correlación es moderada; las pistas con LEC alta ganan posición respecto a la $Q$ Inicial. \textit  {Centro}: $Q$ Inicial vs $Q$ Mundo Cerrado — la dispersión alrededor de la diagonal es mayor, indicando un reordenamiento más profundo inducido por el peso dominante de PD. \textit  {Derecha}: $Q$ Mundo Abierto vs $Q$ Mundo Cerrado — el tercer scatter muestra directamente cuánto difiere el ordenamiento de las pistas entre las dos fórmulas empíricas: las pistas que tienen PD alto pero LEC baja suben en mundo cerrado y bajan en mundo abierto, y viceversa.}}{26}{figure.caption.29}\protected@file@percent }
\newlabel{fig:q_scatter_f2}{{18}{26}{Diagramas de dispersión para cada par de variantes. \textit {Izquierda}: $Q$ Inicial vs $Q$ Mundo Abierto — la correlación es moderada; las pistas con LEC alta ganan posición respecto a la $Q$ Inicial. \textit {Centro}: $Q$ Inicial vs $Q$ Mundo Cerrado — la dispersión alrededor de la diagonal es mayor, indicando un reordenamiento más profundo inducido por el peso dominante de PD. \textit {Derecha}: $Q$ Mundo Abierto vs $Q$ Mundo Cerrado — el tercer scatter muestra directamente cuánto difiere el ordenamiento de las pistas entre las dos fórmulas empíricas: las pistas que tienen PD alto pero LEC baja suben en mundo cerrado y bajan en mundo abierto, y viceversa}{figure.caption.29}{}}
\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Estadísticos descriptivos de las tres variantes de $Q$ sobre las 360 pistas del corpus, con correlaciones de Pearson entre pares ($N=360$).}}{27}{table.caption.30}\protected@file@percent }
\newlabel{tab:q_stats_f2}{{12}{27}{Estadísticos descriptivos de las tres variantes de $Q$ sobre las 360 pistas del corpus, con correlaciones de Pearson entre pares ($N=360$)}{table.caption.30}{}}
