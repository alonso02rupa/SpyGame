\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Validación completa del modelo logístico en Fase 2. Se incluyen la curva ROC sobre el conjunto de prueba, las métricas de validación cruzada estratificada (accuracy, AUC, F1, log-loss) y el reporte de clasificación. La curva ROC muestra capacidad discriminativa modesta pero consistentemente superior al azar.}}{22}{figure.caption.21}\protected@file@percent }
\newlabel{fig:logistic_val_f2}{{11}{22}{Validación completa del modelo logístico en Fase 2. Se incluyen la curva ROC sobre el conjunto de prueba, las métricas de validación cruzada estratificada (accuracy, AUC, F1, log-loss) y el reporte de clasificación. La curva ROC muestra capacidad discriminativa modesta pero consistentemente superior al azar}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Curva ROC con validación cruzada de 5 pliegues (Fase 2). La banda sombreada representa la desviación estándar entre pliegues. El AUC medio de $0.548 \pm 0.058$ es inferior al obtenido en mundo abierto ($0.565 \pm 0.027$) y presenta mayor varianza entre pliegues, reflejo del menor tamaño muestral.}}{22}{figure.caption.22}\protected@file@percent }
\newlabel{fig:roc_cv_f2}{{12}{22}{Curva ROC con validación cruzada de 5 pliegues (Fase 2). La banda sombreada representa la desviación estándar entre pliegues. El AUC medio de $0.548 \pm 0.058$ es inferior al obtenido en mundo abierto ($0.565 \pm 0.027$) y presenta mayor varianza entre pliegues, reflejo del menor tamaño muestral}{figure.caption.22}{}}
